# Backend settings for Campus Customs.
# Copy this file to .env (in this hw4 folder) and fill in your own values.
# Never commit or share the real .env file.

# Required for the AI chatbot. Without it, the chat uses the built-in rule-based fallback.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: model and gateway used by the chatbot (defaults shown).
PORTKEY_MODEL=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: password for the protected /api/admin/users endpoint.
# Set your own; the code falls back to a built-in default if this is left out.
ADMIN_PASSWORD=choose-an-admin-password
